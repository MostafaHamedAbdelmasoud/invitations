# Copy to .env and fill in. Never prefix these with VITE_ (that would publish them). See EMAIL.md.
#
# Who this invitation's RSVPs and wishes go to: the couple's own address. At build time it's encrypted with
# MAIL_ENCRYPTION_KEY into a token for the email API; only the token reaches the public site.
# The account the mail is SENT FROM lives in the mail server's .env, so nothing here is a mailbox login.
SMTP_TO=

# Optional: send this invitation through its own account instead of the mail server's. Leave it all unset
# unless you mean it; whatever is set here is baked into the token and overrides the server for this site.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Khaled & Shorouk Wedding <no-reply@example.com>"

# Sites allowed to call the email API from a browser (comma-separated). localhost is always allowed.
ALLOWED_ORIGINS=https://maryamandmahmoud.com,https://www.maryamandmahmoud.com

# Optional (public, not a secret): another send-mail.php to call. Default: https://api.maryamandmahmoud.com/send-mail.php
# VITE_MAIL_ENDPOINT=https://api.example.com/send-mail.php


# Encrypts SMTP_TO above for the email API; the same value goes in the server's .env.
# Make one with: npm run mail:key
MAIL_ENCRYPTION_KEY=

# Which email template the mail server uses for this invitation: a folder in api/templates/ (public, not a secret)
VITE_MAIL_TEMPLATE=khaled-shorouk
