# Public build setting (not a secret): the hosted email API the live site posts RSVPs and wishes to.
VITE_MAIL_ENDPOINT=https://api.maryamandmahmoud.com/send-mail.php

# The email template for this invitation: a folder in api/templates/ on the mail server.
VITE_MAIL_TEMPLATE=khaled-shorouk

# Where the site is served from (public, not a secret). GitHub Pages serves this repo at
# https://mostafahamedabdelmasoud.github.io/khaled-shorouk/, so its files live under /khaled-shorouk/.
# Use SITE_BASE=/ if the site moves to a domain of its own.
SITE_BASE=/khaled-shorouk/
